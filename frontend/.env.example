# Variables del frontend. Copia este archivo a .env.local para desarrollo.
#
# OJO: todo lo que empieza por NEXT_PUBLIC_ viaja al navegador y queda a la vista
# de cualquiera. Aqui NUNCA van claves secretas, solo identificadores publicos.

# ─── API ──────────────────────────────────────────────────────────────────────
# En desarrollo apunta al backend local; en produccion, a api.ventrix.lat
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ─── ENTRAR CON GOOGLE (opcional) ─────────────────────────────────────────────
# ID de cliente OAuth de Google (es publico por diseño, no es un secreto).
# DEBE ser el MISMO valor que el GOOGLE_CLIENT_ID del backend.
#
# Como se saca:
#   1. https://console.cloud.google.com  ->  crea un proyecto (o usa uno)
#   2. APIs y servicios -> Pantalla de consentimiento de OAuth
#        Tipo: Externo. Llena nombre de la app, correo de soporte y publicala.
#   3. APIs y servicios -> Credenciales -> Crear credenciales
#        -> ID de cliente de OAuth -> Aplicacion web
#   4. Origenes autorizados de JavaScript (sin barra al final):
#        https://ventrix.lat
#        https://www.ventrix.lat
#        http://localhost:3000
#   5. Copia el "ID de cliente" (termina en .apps.googleusercontent.com) y pegalo
#      aqui y en el backend.
#
# Vacio = el boton de Google simplemente no se muestra en /login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
