generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ROLES ────────────────────────────────────────────────────────────────────
enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  CASHIER
  SELLER
  WAREHOUSE
  // Ayudante del contador en Ventrix Contable: permisos limitados (ve clientes y
  // gestiona vencimientos, pero no borra clientes ni toca la cuenta ni el cobro).
  // Es el único rol nuevo del módulo contable; el dueño sigue siendo ADMIN.
  AUXILIAR
}

// ─── ESTADOS GENERALES ────────────────────────────────────────────────────────
enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CreditStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  NEQUI
  DAVIPLATA
  CARD
  MIXED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// ─── USERS ────────────────────────────────────────────────────────────────────
model User {
  id                   String             @id @default(uuid())
  name                 String
  email                String             @unique
  phone                String?
  password             String
  googleId             String?            @unique
  role                 UserRole           @default(CASHIER)
  isActive             Boolean            @default(true)
  isEmailVerified      Boolean            @default(false)
  emailVerifyToken     String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  avatar               String?
  lastLogin            DateTime?
  refreshTokens        RefreshToken[]
  // Un usuario puede ser dueño de varios negocios: así un mismo correo/clave
  // tiene POS y Contable a la vez y elige a cuál entrar tras iniciar sesión.
  businesses           Business[]         @relation("BusinessOwner")
  branchId             String?
  branch               Branch?            @relation(fields: [branchId], references: [id])
  createdBranches      Branch[]           @relation("BranchCreator")
  createdTransfers     StockTransfer[]
  cashMovements        CashMovement[]
  sales                Sale[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?

  @@index([email])
  @@index([branchId])
  @@index([emailVerifyToken])
  @@index([resetPasswordToken])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── BUSINESS ─────────────────────────────────────────────────────────────────
model Business {
  id                 String            @id @default(uuid())
  name               String
  // Discriminador de producto: "pos" (comercio, el POS de siempre) o "contable"
  // (agenda tributaria para contadores). Los negocios existentes quedan "pos"
  // por el default, así que su comportamiento no cambia en nada.
  type               String            @default("pos")
  category           String?
  legalName          String?
  nit                String?
  phone              String?
  email              String?
  address            String?
  city               String?
  country            String            @default("Colombia")
  logo               String?
  currency           String            @default("COP")
  taxRate            Decimal           @default(0)
  // Estado del onboarding (guía de primeros pasos) — cross-device. JSON flexible:
  // { welcomeSeenAt, tourDoneAt, dismissedAt, firstSaleAt, legacy }. null = negocio
  // nuevo (recibe la bienvenida). Los negocios que ya existían al migrar quedan
  // marcados como vistos (legacy) para no molestar a los usuarios actuales.
  onboarding         Json?
  // Pago en el catálogo público: un link de pago (Wompi/Bold/Nequi…) y/o la
  // imagen de un QR para que el cliente pague directo al hacer el pedido.
  catalogPaymentLink String?
  catalogPaymentQr   String?
  // Último día en que se envió el push-resumen de vencimientos a esta oficina
  // contable. El aviso se repite TODOS los días mientras haya obligaciones sin
  // presentar (por eso no basta con el dedup de la campanita), pero una sola vez
  // al día: sin esta marca, cada reinicio del servidor volvería a sonarle.
  lastVencPushAt     DateTime?
  ownerId            String
  owner              User              @relation("BusinessOwner", fields: [ownerId], references: [id])
  branches           Branch[]
  categories         Category[]
  customers          Customer[]
  suppliers          Supplier[]
  brands             Brand[]
  purchases          Purchase[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  products           Product[]
  stockTransfers     StockTransfer[]
  plan               String            @default("free")
  planExpiresAt      DateTime?
  // Vendedora que creó esta cuenta desde su portal (si aplica). Sirve para que
  // cada vendedora vea "sus" cuentas y el dueño sepa quién provisionó cada una.
  createdBySellerId  String?
  // Referencia de la transacción de Wompi con la que se pagó esta cuenta (cuando
  // la creó una vendedora). @unique = un mismo pago no puede crear dos cuentas.
  paymentRef         String?           @unique
  settings           Json?
  paymentLinks       PaymentLink[]
  aiWeeklySummaries  AiWeeklySummary[]
  // Medios de pago configurables (Efectivo, Bancolombia, BBVA, Caja 1, Nequi…).
  // Reemplazan progresivamente al enum PaymentMethod fijo. Ver PaymentAccount.
  paymentAccounts    PaymentAccount[]
  // Ventrix Contable: los clientes tributarios de una oficina contable. Solo se
  // usan cuando type == "contable"; en una cuenta POS la relación queda vacía.
  taxClients         TaxClient[]
  quotes             Quote[]
  supplierCredits    SupplierCredit[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  @@index([ownerId])
  @@index([createdBySellerId])
  @@map("businesses")
}

// ─── SELLERS ───────────────────────────────────────────────────────────────────
// Vendedoras que provisionan cuentas de clientes desde su propio portal
// (/vendedor): el cliente paga por su link de Wompi y la vendedora le crea la
// cuenta ya lista (verificada, en Pro, con clave) para enviársela por WhatsApp.
// El `slug` coincide con /planes?v=<slug> para atar el lead al vendedor.
model Seller {
  id            String                  @id @default(uuid())
  name          String
  email         String                  @unique
  password      String
  slug          String                  @unique
  phone         String?
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  pushSubs      SellerPushSubscription[]

  @@map("sellers")
}

// Suscripción push del portal de vendedoras. Va aparte de PushSubscription
// porque las vendedoras no son User: tienen su propia tabla y su propia sesión
// (authSeller). Así el aviso de "te compraron" no depende de darles una cuenta
// de usuario que no necesitan.
model SellerPushSubscription {
  id        String   @id @default(uuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@map("seller_push_subscriptions")
}

// ─── AI WEEKLY SUMMARY ─────────────────────────────────────────────────────────
// Resumen semanal en lenguaje natural (Pro) — generado perezosamente (no cron),
// persistido en Postgres porque Redis en esta app es opcional/efímero y no debe
// ser la única copia de algo que cuesta dinero real generar.
model AiWeeklySummary {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  summary    String   @db.Text
  metrics    Json
  model      String
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("ai_weekly_summaries")
}

// ─── PAYMENT LINKS (Wompi) ─────────────────────────────────────────────────────
// Mapeo linkId → negocio que sobrevive más allá del TTL de Redis y no se pisa
// entre sí cuando se generan varios links seguidos (reintentos de checkout):
// antes esto vivía en un solo campo `business.settings.pendingPayment` que la
// siguiente llamada a createLink sobreescribía, así que si el webhook de un
// link viejo llegaba tarde (después de expirar el caché), ya no encontraba a
// qué negocio pertenecía y el pago quedaba cobrado sin activar el plan.
model PaymentLink {
  id         String    @id // Wompi payment_link_id
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  period     String
  months     Int
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@map("payment_links")
}

model Branch {
  id                   String                @id @default(uuid())
  name                 String
  address              String?
  phone                String?
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id])
  // Quién creó la sucursal — pista de auditoría; nunca se usa para autorizar nada,
  // solo para poder revisar el historial si algo se ve raro (ej. reventa de sucursal).
  createdById          String?
  createdBy            User?                 @relation("BranchCreator", fields: [createdById], references: [id])
  users                User[]
  products             Product[]
  sales                Sale[]
  cashRegisters        CashRegister[]
  purchases            Purchase[]
  inventoryMovements   InventoryMovement[]
  productStocks        ProductStock[]
  productVariantStocks ProductVariantStock[]
  purchaseDetails      PurchaseDetail[]
  transfersOut         StockTransfer[]       @relation("TransferFrom")
  transfersIn          StockTransfer[]       @relation("TransferTo")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  @@index([businessId])
  @@map("branches")
}

// ─── CATEGORIES & BRANDS ──────────────────────────────────────────────────────
model Category {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id])
  name        String
  description String?
  color       String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Brand {
  id         String    @id @default(uuid())
  name       String
  logo       String?
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@unique([businessId, name])
  @@index([businessId])
  @@map("brands")
}

// ─── PRODUCTS ─────────────────────────────────────────────────────────────────
model Product {
  id                 String              @id @default(uuid())
  // code is unique per business, not globally — two businesses can share the same code
  code               String
  barcode            String?
  name               String
  description        String?
  categoryId         String?
  category           Category?           @relation(fields: [categoryId], references: [id])
  brandId            String?
  brand              Brand?              @relation(fields: [brandId], references: [id])
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id])
  branchId           String?
  branch             Branch?             @relation(fields: [branchId], references: [id])
  businessId         String
  business           Business            @relation(fields: [businessId], references: [id])
  costPrice          Decimal             @default(0)
  salePrice          Decimal             @default(0)
  wholesalePrice     Decimal?
  // stock and minStock stay Float — they represent inventory quantities, not monetary values
  stock              Float               @default(0)
  minStock           Float               @default(0)
  unit               String              @default("unit")
  image              String?
  images             String[]
  taxRate            Decimal             @default(0)
  isActive           Boolean             @default(true)
  allowNegativeStock Boolean             @default(false)
  // Si es true, el producto se vende por VARIANTES (talla/color): su stock vive
  // en ProductVariant/ProductVariantStock, no en ProductStock. Product.stock
  // sigue siendo el total denormalizado (suma de todas las variantes) para que
  // dashboard/reportes/catálogo/búsqueda lean un solo número, igual que hoy.
  // Apagado por defecto → los productos existentes se comportan idéntico.
  hasVariants        Boolean             @default(false)
  // Marca cuándo se notificó por última vez el stock bajo — evita reenviar la
  // misma alerta en cada venta mientras el stock sigue bajo el mínimo; se
  // limpia (null) cuando el producto se reabastece por encima del mínimo.
  lowStockNotifiedAt DateTime?
  saleDetails        SaleDetail[]
  purchaseDetails    PurchaseDetail[]
  inventoryMovements InventoryMovement[]
  // Total denominado en Product.stock = SUM(productStocks.stock) — se mantiene
  // sincronizado en cada venta/compra/ajuste/transferencia para que dashboard,
  // reportes, exportaciones, catálogo público y búsqueda sigan leyendo un solo
  // número sin tener que enterarse de que el stock ahora vive por bodega.
  productStocks      ProductStock[]
  variants           ProductVariant[]
  transferItems      StockTransferItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@unique([businessId, code])
  @@index([businessId, barcode])
  @@index([businessId, name])
  @@index([businessId, isActive])
  @@index([categoryId])
  @@index([branchId])
  @@index([businessId])
  @@map("products")
}

// Stock real por bodega — un producto tiene una fila aquí por cada bodega
// donde tiene existencias. Product.stock sigue siendo el total (ver arriba).
model ProductStock {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  stock     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("product_stocks")
}

// ─── VARIANTES DE PRODUCTO (ropa: tallas/colores) ─────────────────────────────
// Solo se usan cuando Product.hasVariants = true. Cada variante es una combinación
// (talla y/o color) con su propio stock por bodega (ProductVariantStock). Mismo
// precio que el producto (decisión de negocio; el precio vive en Product). Los
// productos simples (hasVariants=false) no crean ninguna fila aquí y funcionan
// exactamente como hoy.
model ProductVariant {
  id              String                @id @default(uuid())
  productId       String
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  talla           String?
  color           String?
  active          Boolean               @default(true)
  stocks          ProductVariantStock[]
  saleDetails     SaleDetail[]
  purchaseDetails PurchaseDetail[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductVariantStock {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch         @relation(fields: [branchId], references: [id])
  stock     Float          @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([variantId, branchId])
  @@index([branchId])
  @@map("product_variant_stocks")
}

model StockTransfer {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id])
  fromBranchId String
  fromBranch   Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId   String
  toBranch     Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id])
  notes        String?
  items        StockTransferItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  // Soft delete — anular una transferencia revierte el stock pero conserva el
  // registro, porque los InventoryMovement de auditoría apuntan a este id.
  deletedAt    DateTime?

  @@index([businessId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Float

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

// ─── INVENTORY MOVEMENTS ──────────────────────────────────────────────────────
model InventoryMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  type          MovementType
  // quantity/previousStock/newStock stay Float — inventory quantities, not money
  quantity      Float
  previousStock Float
  newStock      Float
  // Monetary cost fields — enable a proper accounting ledger per movement
  unitCost      Decimal      @default(0)
  totalCost     Decimal      @default(0)
  reason        String?
  referenceId   String?
  referenceType String?
  notes         String?
  // Nullable — movimientos históricos (antes de esta función) quedan sin bodega.
  branchId      String?
  branch        Branch?      @relation(fields: [branchId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([productId])
  @@index([referenceId])
  @@index([productId, createdAt])
  @@index([branchId])
  @@map("inventory_movements")
}

// ─── CUSTOMERS ────────────────────────────────────────────────────────────────
model Customer {
  id            String    @id @default(uuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id])
  name          String
  document      String?
  documentType  String?   @default("CC")
  phone         String?
  email         String?
  address       String?
  city          String?
  notes         String?
  creditLimit   Decimal   @default(0)
  currentDebt   Decimal   @default(0)
  loyaltyPoints Int       @default(0)
  isActive      Boolean   @default(true)
  sales         Sale[]
  credits       Credit[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@unique([businessId, document])
  @@index([businessId])
  @@index([businessId, name])
  @@index([businessId, currentDebt])
  @@index([document])
  @@map("customers")
}

// ─── SUPPLIERS ────────────────────────────────────────────────────────────────
model Supplier {
  id              String           @id @default(uuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id])
  name            String
  legalName       String?
  document        String?
  phone           String?
  mobile          String?
  email           String?
  address         String?
  city            String?
  contactName     String?
  notes           String?
  isActive        Boolean          @default(true)
  // Lo que el NEGOCIO le debe al proveedor por compras a crédito (espejo de
  // Customer.currentDebt). Sube al comprar a crédito, baja al abonar.
  currentDebt     Decimal          @default(0)
  products        Product[]
  purchases       Purchase[]
  expenses        Expense[]
  supplierCredits SupplierCredit[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@unique([businessId, document])
  @@index([businessId])
  @@index([businessId, currentDebt])
  @@map("suppliers")
}

// ─── SALES ────────────────────────────────────────────────────────────────────
model Sale {
  id               String          @id @default(uuid())
  invoiceNumber    String
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id])
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id])
  status           SaleStatus      @default(COMPLETED)
  subtotal         Decimal
  taxAmount        Decimal         @default(0)
  discountAmount   Decimal         @default(0)
  total            Decimal
  paidAmount       Decimal
  changeAmount     Decimal         @default(0)
  paymentMethod    PaymentMethod   @default(CASH)
  // Medio de pago configurable (nullable durante la transición; convive con el
  // enum de arriba). En ventas MIXTAS queda null: el desglose va en paymentDetails.
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  paymentDetails   Json?
  notes            String?
  details          SaleDetail[]
  credit           Credit?
  returns          Return[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  @@unique([branchId, invoiceNumber])
  @@index([customerId])
  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([status, createdAt])
  @@index([branchId, status, createdAt])
  @@index([paymentAccountId])
  @@map("sales")
}

model SaleDetail {
  id               String          @id @default(uuid())
  saleId           String
  sale             Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  // Variante vendida (talla/color) cuando el producto maneja variantes; null en
  // productos simples. Determina de qué variante se descuenta el stock.
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity         Float
  unitPrice        Decimal
  costPrice        Decimal
  discountPct      Decimal         @default(0)
  taxRate          Decimal         @default(0)
  subtotal         Decimal
  total            Decimal
  createdAt        DateTime        @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([productVariantId])
  @@map("sale_details")
}

// Devolución / nota crédito de una venta. Puede ser total o parcial (por ítem y
// cantidad). Revierte stock, caja y/o crédito igual que la anulación, pero por la
// porción devuelta. branchId/userId/customerId/productId van como columnas (sin
// FK), igual que InventoryMovement, para no atar el borrado a estas tablas.
model Return {
  id           String         @id @default(uuid())
  returnNumber String // Correlativo NC-0001 por sucursal
  saleId       String
  sale         Sale           @relation(fields: [saleId], references: [id])
  branchId     String
  userId       String // Quién registró la devolución
  customerId   String?
  total        Decimal        @default(0) // Monto total reembolsado
  reason       String?
  // Cómo se reembolsó: CASH (salida de caja), CREDIT (baja saldo del fiado),
  // MIXED (ambos) o NONE (monto 0 / sin movimiento).
  refundMethod String         @default("NONE")
  restock      Boolean        @default(true) // Si repuso el inventario
  createdAt    DateTime       @default(now())
  details      ReturnDetail[]

  @@unique([branchId, returnNumber])
  @@index([saleId])
  @@index([branchId])
  @@index([createdAt])
  @@map("returns")
}

model ReturnDetail {
  id               String   @id @default(uuid())
  returnId         String
  return           Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleDetailId     String? // Línea original de la venta
  productId        String
  productVariantId String?
  productName      String // Snapshot del nombre para el historial
  quantity         Float
  unitPrice        Decimal // Precio efectivo por unidad reembolsado
  total            Decimal
  createdAt        DateTime @default(now())

  @@index([returnId])
  @@index([productId])
  @@map("return_details")
}

// ─── PURCHASES ────────────────────────────────────────────────────────────────
model Purchase {
  id               String           @id @default(uuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id])
  invoiceNumber    String?
  supplierId       String
  supplier         Supplier         @relation(fields: [supplierId], references: [id])
  status           PurchaseStatus   @default(COMPLETED)
  subtotal         Decimal
  taxAmount        Decimal          @default(0)
  total            Decimal
  paymentMethod    PaymentMethod    @default(CASH)
  paymentAccountId String?
  paymentAccount   PaymentAccount?  @relation(fields: [paymentAccountId], references: [id])
  // Pago dividido: monto pagado AHORA (suma de los medios no-crédito) y el
  // desglose { splits: [{ method, amount, paymentAccountId? }] }. En pago simple
  // paidAmount = total y paymentDetails queda null (comportamiento de siempre).
  paidAmount       Decimal          @default(0)
  paymentDetails   Json?
  supplierCredit   SupplierCredit?
  invoicePdf       String?
  notes            String?
  purchaseDate     DateTime         @default(now())
  details          PurchaseDetail[]
  // Nullable — compras históricas (antes de esta función) quedan sin bodega.
  branchId         String?
  branch           Branch?          @relation(fields: [branchId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([supplierId])
  @@index([businessId])
  @@index([branchId])
  @@index([businessId, purchaseDate])
  @@index([paymentAccountId])
  @@map("purchases")
}

model PurchaseDetail {
  id               String          @id @default(uuid())
  purchaseId       String
  purchase         Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  quantity         Float
  unitCost         Decimal
  taxRate          Decimal         @default(0)
  subtotal         Decimal
  total            Decimal
  // Nullable — detalles de antes de este campo quedan sin bodega propia; se
  // asume la de Purchase.branchId (o la más antigua del negocio) al editar/
  // eliminar. Ver legacyBranchId en purchase.routes.ts.
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  createdAt        DateTime        @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@index([branchId])
  @@index([productVariantId])
  @@map("purchase_details")
}

// Crédito a PROVEEDOR: lo que el negocio queda debiendo tras una compra a
// crédito (espejo de Credit/CreditPayment de clientes). Abonar saca plata de la
// caja (a diferencia del fiado de cliente, que la mete).
model SupplierCredit {
  id          String                  @id @default(uuid())
  purchaseId  String?                 @unique
  purchase    Purchase?               @relation(fields: [purchaseId], references: [id])
  supplierId  String
  supplier    Supplier                @relation(fields: [supplierId], references: [id])
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id])
  totalAmount Decimal
  paidAmount  Decimal                 @default(0)
  balance     Decimal
  status      CreditStatus            @default(PENDING)
  dueDate     DateTime?
  notes       String?
  payments    SupplierCreditPayment[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?

  @@index([supplierId])
  @@index([businessId])
  @@index([businessId, status])
  @@map("supplier_credits")
}

model SupplierCreditPayment {
  id               String          @id @default(uuid())
  supplierCreditId String
  supplierCredit   SupplierCredit  @relation(fields: [supplierCreditId], references: [id], onDelete: Cascade)
  amount           Decimal
  paymentMethod    PaymentMethod   @default(CASH)
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([supplierCreditId])
  @@index([paymentAccountId])
  @@map("supplier_credit_payments")
}

// ─── EXPENSES ─────────────────────────────────────────────────────────────────
model ExpenseCategory {
  id          String    @id @default(uuid())
  businessId  String?
  business    Business? @relation(fields: [businessId], references: [id])
  name        String
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@map("expense_categories")
}

model Expense {
  id                String           @id @default(uuid())
  businessId        String?
  business          Business?        @relation(fields: [businessId], references: [id])
  categoryId        String?
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description       String
  amount            Decimal
  paymentMethod     PaymentMethod    @default(CASH)
  paymentAccountId  String?
  paymentAccount    PaymentAccount?  @relation(fields: [paymentAccountId], references: [id])
  receiptUrl        String?
  date              DateTime         @default(now())
  notes             String?
  recipientName     String?
  recipientDocument String?
  recipientPhone    String?
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@index([businessId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([date])
  @@index([businessId, date])
  @@index([paymentAccountId])
  @@map("expenses")
}

// ─── CREDITS / FIADOS ─────────────────────────────────────────────────────────
model Credit {
  id          String          @id @default(uuid())
  saleId      String?         @unique
  sale        Sale?           @relation(fields: [saleId], references: [id])
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  totalAmount Decimal
  paidAmount  Decimal         @default(0)
  balance     Decimal
  status      CreditStatus    @default(PENDING)
  dueDate     DateTime?
  notes       String?
  payments    CreditPayment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([status, dueDate])
  @@map("credits")
}

model CreditPayment {
  id               String          @id @default(uuid())
  creditId         String
  credit           Credit          @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount           Decimal
  paymentMethod    PaymentMethod   @default(CASH)
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([creditId])
  @@index([paymentAccountId])
  @@map("credit_payments")
}

// ─── PAYMENT ACCOUNTS (medios de pago configurables) ──────────────────────────
// Lista por negocio de medios de pago / cuentas donde entra o sale la plata
// (Efectivo, Bancolombia, BBVA, Caja 1, Nequi del negocio…). El contador los
// crea/edita en Configuración (patrón de Bodegas). Reemplazan al enum fijo
// PaymentMethod; mientras conviven, `legacyEnum` mapea al valor viejo para que
// reportes/exportaciones no se rompan. `type` define cuáles son EFECTIVO (los
// únicos que alimentan la caja física).
model PaymentAccount {
  id                     String                  @id @default(uuid())
  businessId             String
  business               Business                @relation(fields: [businessId], references: [id])
  name                   String
  type                   PaymentAccountType      @default(OTHER)
  legacyEnum             PaymentMethod?
  active                 Boolean                 @default(true)
  order                  Int                     @default(0)
  sales                  Sale[]
  purchases              Purchase[]
  expenses               Expense[]
  creditPayments         CreditPayment[]
  supplierCreditPayments SupplierCreditPayment[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([businessId])
  @@map("payment_accounts")
}

enum PaymentAccountType {
  CASH
  BANK
  OTHER
}

// ─── CASH REGISTER ────────────────────────────────────────────────────────────
model CashRegister {
  id             String         @id @default(uuid())
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id])
  openedBy       String
  closedBy       String?
  openingAmount  Decimal
  closingAmount  Decimal?
  expectedAmount Decimal?
  difference     Decimal?
  status         String         @default("OPEN")
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  notes          String?
  movements      CashMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([branchId, status])
  @@map("cash_registers")
}

model CashMovement {
  id             String       @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  type           MovementType
  amount         Decimal
  description    String
  referenceId    String?
  // Nullable — movimientos de antes de este campo quedan sin autor conocido.
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([cashRegisterId])
  @@index([createdById])
  @@map("cash_movements")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@map("notifications")
}

// Suscripción de Web Push de un dispositivo/navegador. Permite enviar la alerta
// de vencimientos al móvil aunque la app esté cerrada. Un usuario puede tener
// varias (celular, PC…). Se limpia sola: al fallar el envío (endpoint expirado)
// se borra, y cascada al borrar el usuario.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@index([entityId])
  @@map("audit_logs")
}

// ─── INVOICE COUNTERS ─────────────────────────────────────────────────────────
model SaleNumberCounter {
  branchId  String
  dayPrefix String
  lastSeq   Int    @default(0)

  @@id([branchId, dayPrefix])
  @@map("sale_number_counters")
}

// ─── Cotización / proforma (documento previo a la venta) ───────────────────────
// Los ítems se guardan como JSON (snapshot): una cotización es un documento y no
// se consulta por ítem, así se evita una tabla puente y sobrevive a cambios del
// producto. customerId/branchId/createdById son ids sueltos (sin FK) a propósito.
model Quote {
  id             String    @id @default(uuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id])
  branchId       String?
  number         String
  customerId     String?
  customerName   String?
  items          Json
  subtotal       Decimal
  taxAmount      Decimal   @default(0)
  discountAmount Decimal   @default(0)
  total          Decimal
  notes          String?
  validUntil     DateTime? @db.Date
  status         String    @default("PENDING") // PENDING | CONVERTED
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([businessId])
  @@map("quotes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// VENTRIX CONTABLE — dominio de la agenda tributaria para contadores.
//
// Todo lo "por cliente" cuelga de Business (multi-tenant estricto, igual que el
// POS). Los catálogos y calendarios son GLOBALES (iguales para todas las
// oficinas). El cliente del contador es TaxClient — NO se reusa Customer, que
// son los compradores de la tienda en el POS.
// ═══════════════════════════════════════════════════════════════════════════════

// Calidades tributarias del RUT. La ausencia de `responsable_iva` significa
// "no responsable de IVA": no hay código para eso, así se evitan estados
// imposibles (ver reglas de exclusión RST en la lógica de dominio).
enum Calidad {
  responsable_iva
  declarante_renta
  agente_retenedor
  impoconsumo
  rst

  @@map("calidad")
}

// Obligaciones que un contador vigila. `impoconsumo` existe como calidad y como
// obligación (son enums distintos, no colisionan).
enum Obligacion {
  renta
  iva
  retefuente
  ica
  exogena
  pila
  impoconsumo
  simple
  nomina

  @@map("obligacion")
}

enum TipoPersona {
  natural
  juridica

  @@map("tipo_persona")
}

enum IvaPeriodicidad {
  bimestral
  cuatrimestral

  @@map("iva_periodicidad")
}

enum EstadoVencimiento {
  pendiente
  en_proceso
  presentada
  pagada
  vencida

  @@map("estado_vencimiento")
}

enum TipoResolucion {
  factura_electronica
  documento_soporte
  otra

  @@map("tipo_resolucion")
}

enum ModalidadResolucion {
  pos
  electronica
  contingencia

  @@map("modalidad_resolucion")
}

enum EstadoResolucion {
  vigente
  por_vencer
  vencida
  agotada

  @@map("estado_resolucion")
}

// Clasificación DIAN de la resolución de numeración: autorización (tradicional/
// POS) o habilitación (para facturación electrónica). La pide el contador.
enum ClaseResolucion {
  autorizacion
  habilitacion

  @@map("clase_resolucion")
}

// ─── Cliente del contador (multi-tenant) ───────────────────────────────────────
model TaxClient {
  id                String                  @id @default(uuid())
  businessId        String
  business          Business                @relation(fields: [businessId], references: [id])
  razonSocial       String
  nit               String
  // Dígito de verificación: se calcula solo con la fórmula oficial DIAN al
  // guardar (no lo digita el usuario).
  dv                Int
  celular           String?
  direccion         String?
  tipoPersona       TipoPersona
  // Array de enum de Postgres (más simple que una tabla puente a esta escala).
  responsabilidades Calidad[]
  // Solo aplica si es responsable de IVA; null en caso contrario. La define el
  // contador según los ingresos, no se deduce de las calidades.
  ivaPeriodicidad   IvaPeriodicidad?
  activo            Boolean                 @default(true)
  vencimientos      Vencimiento[]
  resoluciones      ResolucionDian[]
  respManuales      ResponsabilidadManual[]
  credenciales      ClientCredential[]
  documentos        ClientDocument[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // No repetir un cliente por NIT dentro de la misma oficina.
  @@unique([businessId, nit, dv])
  @@index([businessId])
  @@map("tax_clients")
}

// Bóveda de credenciales de portales (DIAN/MUISCA, Aportes en Línea, etc.) por
// cliente. La contraseña (claveEnc) se guarda CIFRADA (AES-256-GCM) — ver
// utils/crypto.ts —; el contador la ve/copia en la app (se descifra al leer).
model ClientCredential {
  id          String    @id @default(uuid())
  taxClientId String
  taxClient   TaxClient @relation(fields: [taxClientId], references: [id], onDelete: Cascade)
  entidad     String // "DIAN", "Aportes en Línea", etc.
  usuario1    String
  usuario2    String? // opcional (p. ej. segundo documento en MUISCA)
  claveEnc    String // contraseña cifrada
  link        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([taxClientId])
  @@map("client_credentials")
}

// Bóveda de documentos del cliente (RUT, cámara de comercio, declaraciones…).
// El archivo se guarda en Cloudinary; aquí solo la referencia. Cascada al borrar
// el cliente (el archivo en Cloudinary queda huérfano — se limpia best-effort en
// el borrado explícito).
model ClientDocument {
  id          String    @id @default(uuid())
  taxClientId String
  taxClient   TaxClient @relation(fields: [taxClientId], references: [id], onDelete: Cascade)
  nombre      String
  categoria   String? // "RUT" | "Cámara de comercio" | "Declaración" | "Otro"
  url         String
  mimeType    String?
  size        Int?
  createdAt   DateTime  @default(now())

  @@index([taxClientId])
  @@map("client_documents")
}

// Estas dos son mini-agendas MANUALES para lo que NO está en el calendario DIAN:
//  - exogena: información exógena (anual) — se conserva.
//  - otra:    "otras responsabilidades" — se auto-borran 2 meses después de la
//             fecha, para no saturar la lista (purga perezosa al consultar).
enum TipoRespManual {
  exogena
  otra

  @@map("tipo_resp_manual")
}

enum EstadoRespManual {
  pendiente
  presentado

  @@map("estado_resp_manual")
}

model ResponsabilidadManual {
  id          String           @id @default(uuid())
  taxClientId String
  taxClient   TaxClient        @relation(fields: [taxClientId], references: [id], onDelete: Cascade)
  tipo        TipoRespManual
  // "actividad" (otras responsabilidades) o "concepto/formato" (exógena).
  concepto    String
  fecha       DateTime         @db.Date
  estado      EstadoRespManual @default(pendiente)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([taxClientId])
  @@index([tipo, fecha])
  @@map("responsabilidades_manuales")
}

// ─── Vencimiento de una obligación (scoped vía TaxClient) ──────────────────────
model Vencimiento {
  id          String            @id @default(uuid())
  taxClientId String
  taxClient   TaxClient         @relation(fields: [taxClientId], references: [id], onDelete: Cascade)
  obligacion  Obligacion
  periodo     String
  // Se propone desde el calendario (por dígito del NIT) pero es editable.
  fecha       DateTime          @db.Date
  estado      EstadoVencimiento @default(pendiente)
  monto       Decimal?
  notas       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([taxClientId, obligacion, periodo])
  @@index([taxClientId])
  @@index([fecha])
  @@map("vencimientos")
}

// ─── Resolución DIAN de facturación (scoped vía TaxClient) ─────────────────────
model ResolucionDian {
  id                String               @id @default(uuid())
  taxClientId       String
  taxClient         TaxClient            @relation(fields: [taxClientId], references: [id], onDelete: Cascade)
  tipo              TipoResolucion
  // Autorización o habilitación (nullable: registros previos no lo tenían).
  clase             ClaseResolucion?
  numero            String
  fechaExpedicion   DateTime             @db.Date
  prefijo           String?
  rangoDesde        Int?
  rangoHasta        Int?
  consecutivoActual Int                  @default(0)
  modalidad         ModalidadResolucion?
  fechaVigencia     DateTime             @db.Date
  estado            EstadoResolucion     @default(vigente)
  notas             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([taxClientId])
  @@index([fechaVigencia])
  @@map("resoluciones_dian")
}

// ─── Calendario DIAN (GLOBAL, no por Business) ─────────────────────────────────
// Fecha de vencimiento por obligación/variante/periodo y último dígito del NIT.
// Semilla 2026 verificada contra el PDF oficial (ver migración de seed).
model CalendarioDian {
  id           Int      @id @default(autoincrement())
  anio         Int
  // Coincide con los códigos de Obligacion, pero se guarda como String porque es
  // data de referencia sembrada por SQL; no se enum-castea en cada inserción.
  obligacion   String
  // bimestral|cuatrimestral (IVA); juridica|natural (renta); null si no aplica.
  variante     String?
  periodo      String
  periodoOrden Int
  digito       Int
  fecha        DateTime @db.Date

  @@index([anio, obligacion, variante, digito])
  @@map("calendario_dian")
}

// ─── Calendario renta personas naturales (GLOBAL) ──────────────────────────────
// Su clave son los DOS últimos dígitos del NIT/cédula (00–99), no uno solo.
// Una sola declaración anual escalonada ago–oct.
model CalendarioRentaNatural {
  id         Int      @id @default(autoincrement())
  anio       Int
  dosDigitos Int
  fecha      DateTime @db.Date

  @@unique([anio, dosDigitos])
  @@map("calendario_renta_natural")
}

// ─── Compra sin cuenta (pago primero, credenciales después) ────────────────────
// El prospecto entra a /planes (con el link de una vendedora o sin él), elige
// plan, deja solo 4 datos y PAGA. No tiene cuenta todavía: por eso el pago no
// puede colgarse de un Business como PaymentLink. Cuando Wompi confirma, el
// webhook crea el usuario + negocio y le envía las credenciales por correo.
//
// Se guarda antes de mandar a pagar para no depender de lo que Wompi devuelva:
// el correo con el que se crea la cuenta es el que el comprador escribió aquí.
model GuestCheckout {
  id            String    @id @default(uuid())
  // id del payment link de Wompi: es la llave con la que llega el webhook.
  paymentLinkId String    @unique
  productType   String // "pos" | "contable"
  period        String // monthly | quarterly | annual
  months        Int
  amount        Int // COP; el webhook verifica que se haya pagado esto
  buyerName     String
  buyerLastName String
  buyerDoc      String
  buyerEmail    String
  // Celular con WhatsApp: el correo con las claves se va a spam más seguido de
  // lo que uno quisiera, y sin un teléfono la vendedora no tiene cómo avisarle
  // al cliente que su cuenta ya está lista.
  buyerPhone    String
  // Vendedora que compartió el link (?v=slug). Da la comisión y hace que la
  // cuenta aparezca en SU portal. Null = compra directa sin vendedora.
  sellerSlug    String?
  // pending → paid → provisioned. "failed" queda para revisar a mano.
  status        String    @default("pending")
  transactionId String?   @unique
  businessId    String?
  errorMessage  String?
  provisionedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([buyerEmail])
  @@index([sellerSlug])
  @@map("guest_checkouts")
}
